{
  "name": "kwg-directory",
  "version": "0.1.0",
  "private": true,
  "description": "Member directory for the OpenChain Korea Work Group — sign in with GitHub, register a profile, and appear after admin approval.",
  "license": "Apache-2.0",
  "author": "OpenChain Korea Work Group",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenChain-KWG/kwg-directory.git"
  },
  "homepage": "https://github.com/OpenChain-KWG/kwg-directory#readme",
  "bugs": {
    "url": "https://github.com/OpenChain-KWG/kwg-directory/issues"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:testids": "bash scripts/check-testids.sh",
    "test": "vitest run --reporter=verbose",
    "test:unit": "vitest run --reporter=verbose src/tests/unit",
    "test:integration": "vitest run --reporter=verbose src/tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:e2e": "playwright test --grep-invert \"@legacy|@smoke\"",
    "test:e2e:gate": "playwright test --grep @gate --project=chromium",
    "test:e2e:extended": "playwright test --grep @extended",
    "test:e2e:hard": "playwright test --grep @hard",
    "test:e2e:legacy": "playwright test --grep @legacy",
    "test:e2e:smoke:prod": "PW_ENV=prod-smoke PLAYWRIGHT_BASE_URL=https://kwg-directory.vercel.app playwright test --grep @smoke --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:rls && npm run test:e2e:gate && npm run build",
    "kpi:e2e:gate": "node scripts/e2e-kpi-gate.mjs gate-report.json",
    "test:rls": "supabase test db",
    "type-check": "tsc --noEmit",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "openapi:gen": "node scripts/gen-openapi.mjs",
    "openapi:check": "node scripts/gen-openapi.mjs --check",
    "perf:lighthouse": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "test:e2e:visual": "playwright test --grep @visual --project=chromium",
    "test:e2e:visual:update": "playwright test --grep @visual --project=chromium --update-snapshots"
  },
  "dependencies": {
    "@auth/supabase-adapter": "^1.11.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.54.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.12.0",
    "pino": "^10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tmp": "^0.2.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/nextjs": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.1",
    "supabase": "^2.101.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
}
