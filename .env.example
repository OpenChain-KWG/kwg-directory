# =============================================
# KWG Directory — 환경변수 예시 파일
# 이 파일을 복사하여 .env.local로 저장하고 실제 값을 입력하세요.
# cp .env.example .env.local
# =============================================

# ─────────────────────────────────────────────
# Supabase (필수)
# Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# NextAuth v5 (필수)
# NEXTAUTH_SECRET: openssl rand -base64 32 (32자 이상)
# NEXTAUTH_URL: 배포 시 실제 URL로 설정 (로컬은 아래 기본값)
# ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-minimum-32-characters-here

# ─────────────────────────────────────────────
# GitHub OAuth (필수)
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
# ─────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─────────────────────────────────────────────
# Google OAuth (선택 — Google 로그인 사용 시)
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
# Callback URL: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────
# Resend 이메일 (선택 — 관리자 알림 이메일 사용 시)
# https://resend.com → API Keys
# RESEND_FROM_EMAIL 예: KWG Directory <noreply@your-domain.com>
# 미설정 시 이메일 발송을 건너뜀 (서비스 동작에는 영향 없음)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=KWG Directory <noreply@your-domain.com>

# ─────────────────────────────────────────────
# Groups.io 메일링리스트 (선택 — 멤버 승인 시 자동 초대 사용 시)
# https://groups.io → 그룹 설정 → API
# 미설정 시 메일링리스트 초대를 건너뜀
# ─────────────────────────────────────────────
GROUPS_IO_API_KEY=your-groups-io-api-key
GROUPS_IO_GROUP_ID=your-group-id

# ─────────────────────────────────────────────
# Sentry 오류 모니터링 (선택)
# https://sentry.io → 프로젝트 → DSN
# ─────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ─────────────────────────────────────────────
# Upstash Redis — Rate Limiting (선택)
# https://console.upstash.com → Redis → REST API
# 미설정 시 in-memory fallback (로컬/단일 인스턴스)
# ─────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# ─────────────────────────────────────────────
# CSP 모드 (선택 — 기본값: report-only)
# on → Content-Security-Policy 강제 적용 (enforce)
# 미설정 또는 off → Content-Security-Policy-Report-Only
# ─────────────────────────────────────────────
# NEXT_PUBLIC_FF_CSP_ENFORCE=on

# ─────────────────────────────────────────────
# Admin MFA 강제 (선택 — 기본값: off)
# on → admin 액세스 시 GitHub 계정 2FA 활성화 필수
# off 또는 미설정 → MFA 없이도 admin 허용 (로컬 개발용)
# Production 배포 시 on 권장
# ─────────────────────────────────────────────
# ADMIN_MFA_REQUIRED=on
