  "privacy": {
    "title": "Privacy policy",
    "subtitle": "How OpenChain KWG Directory handles your personal information.",
    "lastUpdated": "Last updated: {date}",
    "lastUpdatedDate": "April 2026",
    "tocTitle": "Table of contents",
    "tocAriaLabel": "Privacy policy table of contents",
    "sections": {
      "collection": {
        "id": "collection",
        "title": "1. Personal information collected",
        "intro": "The OpenChain Korea Work Group member directory (\"the Service\") collects the following information.",
        "items": [
          "Required: name (Korean/English), organization, GitHub account information (collected at sign-in)",
          "Optional: role, short bio, work email, LinkedIn, Discord handle, blog URL, organization category"
        ]
      },
      "purpose": {
        "id": "purpose",
        "title": "2. Purpose of collection and use",
        "items": [
          "Networking and information sharing among OpenChain KWG members",
          "Operating and managing the member directory",
          "Identity verification via GitHub OAuth"
        ]
      },
      "retention": {
        "id": "retention",
        "title": "3. Retention and use period",
        "body": "Personal information is destroyed immediately upon withdrawal (profile deletion request). Where retention is required by law, the information is kept only for the period prescribed by that law."
      },
      "thirdParty": {
        "id": "third-party",
        "title": "4. Third-party disclosure",
        "body": "We do not provide collected personal information to external parties as a rule, except where required by law or where the data subject has consented."
      },
      "processors": {
        "id": "processors",
        "title": "5. Personal information processing entrustment",
        "tableHeaders": {
          "vendor": "Vendor",
          "purpose": "Entrusted task"
        },
        "rows": [
          { "vendor": "Supabase Inc.", "purpose": "Database and file storage" },
          { "vendor": "Vercel Inc.", "purpose": "Web service hosting" },
          { "vendor": "GitHub Inc.", "purpose": "OAuth authentication" }
        ]
      },
      "rights": {
        "id": "rights",
        "title": "6. Rights of the data subject",
        "intro": "Data subjects may exercise the following rights at any time.",
        "items": [
          "Request access, correction, or deletion of their personal information",
          "Request that processing of their personal information be paused"
        ],
        "outro": "These rights can be exercised through the in-app profile editor or by contacting the privacy officer below."
      },
      "withdraw": {
        "id": "withdraw",
        "title": "7. Withdrawing consent",
        "body": "Either delete your profile after signing in, or email the privacy officer to request deletion — your request will be handled immediately."
      },
      "officer": {
        "id": "officer",
        "title": "8. Privacy officer",
        "roleLabel": "Role",
        "roleValue": "OpenChain KWG maintainers",
        "emailLabel": "Email",
        "emailValue": "korea-sg-planning@lists.openchainproject.org"
      },
      "changes": {
        "id": "changes",
        "title": "9. Changes to this policy",
        "body": "This policy may be revised in line with applicable law and service changes. Any changes will be announced in the service."
      }
    }
